
import os
import pandas as pd
import matplotlib.pyplot as plt

# Create folder for saving graphs
os.makedirs("graphs", exist_ok=True)

# Load datasets
anime = pd.read_csv("data/anime.csv")
ratings = pd.read_csv("data/rating.csv")

# Basic data cleaning
anime = anime.drop_duplicates(subset="anime_id").copy()

anime["rating"] = pd.to_numeric(
    anime["rating"], errors="coerce"
)
anime["members"] = pd.to_numeric(
    anime["members"], errors="coerce"
)
anime["episodes"] = pd.to_numeric(
    anime["episodes"], errors="coerce"
)
ratings["rating"] = pd.to_numeric(
    ratings["rating"], errors="coerce"
)

# Remove invalid ratings and missing values
valid_anime = anime.dropna(subset=["name", "rating", "members"])
valid_ratings = ratings[
    ratings["rating"].between(1, 10)
]

plt.rcParams["figure.figsize"] = (10, 6)
plt.rcParams["axes.grid"] = True


def save_graph(filename):
    plt.tight_layout()
    plt.savefig(f"graphs/{filename}", dpi=150)
    plt.show()
    plt.close()


# 1. Top 10 Anime by Average Rating
# Require at least 10,000 members for a fairer comparison
top_rated = (
    valid_anime[valid_anime["members"] >= 10000]
    .nlargest(10, "rating")
    .sort_values("rating")
)

plt.barh(top_rated["name"], top_rated["rating"])
plt.title("Top 10 Anime by Average Rating")
plt.xlabel("Average Rating (out of 10)")
plt.ylabel("Anime")
save_graph("01_top_rated_anime.png")


# 2. Distribution of User Ratings
plt.hist(
    valid_ratings["rating"],
    bins=[0.5, 1.5, 2.5, 3.5, 4.5, 5.5,
          6.5, 7.5, 8.5, 9.5, 10.5],
    edgecolor="black"
)
plt.title("Distribution of User Ratings")
plt.xlabel("User Rating")
plt.ylabel("Number of Ratings")
plt.xticks(range(1, 11))
save_graph("02_rating_distribution.png")


# 3. Top 10 Most Popular Anime
popular = valid_anime.nlargest(10, "members").sort_values("members")

plt.barh(popular["name"], popular["members"])
plt.title("Top 10 Most Popular Anime")
plt.xlabel("Number of Members")
plt.ylabel("Anime")
save_graph("03_popular_anime.png")


# 4. Most Common Anime Genres
genre_counts = (
    anime["genre"]
    .dropna()
    .str.split(",")
    .explode()
    .str.strip()
)
genre_counts = genre_counts[genre_counts.ne("")]
top_genres = genre_counts.value_counts().head(10).sort_values()

plt.barh(top_genres.index, top_genres.values)
plt.title("Top 10 Most Common Anime Genres")
plt.xlabel("Number of Anime")
plt.ylabel("Genre")
save_graph("04_genre_distribution.png")


# 5. Anime Type Distribution
type_counts = anime["type"].fillna("Unknown").value_counts()

plt.pie(
    type_counts,
    labels=type_counts.index,
    autopct="%1.1f%%",
    startangle=90
)
plt.title("Anime Type Distribution")
save_graph("05_anime_type_pie.png")


# 6. Members vs Average Rating
plt.scatter(
    valid_anime["members"],
    valid_anime["rating"],
    alpha=0.5
)
plt.title("Anime Popularity vs Average Rating")
plt.xlabel("Number of Members")
plt.ylabel("Average Rating")
plt.xscale("log")
save_graph("06_members_vs_rating.png")


# 7. Distribution of Anime Episodes
episode_data = anime["episodes"].dropna()
episode_data = episode_data[episode_data > 0]

plt.hist(episode_data, bins=30, edgecolor="black")
plt.title("Distribution of Anime Episodes")
plt.xlabel("Number of Episodes")
plt.ylabel("Number of Anime")
save_graph("07_episode_distribution.png")


# 8. Rating Distribution by Anime Type
types = ["TV", "Movie", "OVA", "Special", "ONA"]

box_data = [
    anime.loc[
        (anime["type"] == anime_type)
        & anime["rating"].between(1, 10),
        "rating"
    ].dropna()
    for anime_type in types
]

plt.boxplot(box_data, tick_labels=types, showfliers=False)
plt.title("Anime Ratings by Type")
plt.xlabel("Anime Type")
plt.ylabel("Average Rating")
save_graph("08_ratings_by_type.png")


print("EDA completed successfully!")
print("All 8 graphs are saved in the graphs folder.")
print("Anime dataset shape:", anime.shape)
print("Rating dataset shape:", ratings.shape)
print("Missing values in anime dataset:")
print(anime.isnull().sum())
